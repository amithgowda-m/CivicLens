# CivicLens Environment Configuration

# LLM Configuration
# Options: gemini | anthropic | openai | ollama
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# API Keys (if using hosted providers)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=

# Ollama Configuration (Default local fallback)
OLLAMA_BASE_URL=http://localhost:11434

# Vector Store Configuration
# Options: postgres | chroma (auto-detects postgres availability, falls back to chroma)
VECTOR_STORE_BACKEND=auto
POSTGRES_USER=civiclens
POSTGRES_PASSWORD=civiclens_secret
POSTGRES_DB=civiclens_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
CHROMA_PERSIST_DIR=backend/data/chroma_db

# Human-In-The-Loop Configuration
AUTO_APPROVE_PENDING_AUDIT=false

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
